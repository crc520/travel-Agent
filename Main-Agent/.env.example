# DeepSeek LLM
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 阿里云百炼 Embedding（记忆向量检索）
BAILIAN_API_KEY=sk-xxx
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_EMB_MODEL=text-embedding-v2

# MySQL数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=xxx
MYSQL_DB=travel_agent_memory_db

# MCP服务脚本路径（推荐改成相对路径，适配不同电脑）
WEATHER_SCRIPT_PATH=./Main-Agent/weather/weather.py
FS_SCRIPT_PATH=./Main-Agent/weather/fs_mcp_server.py
MEMORY_SERVER_PATH=./Main-Agent/weather/memory_mcp_server.py
RAG_SERVER_PATH=./Main-Agent/weather/rag_mcp_server.py

# 虚拟环境解释器路径
PYTHON_EXE_PATH=./.venv/Scripts/python.exe

# Langfuse 观测追踪
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com
